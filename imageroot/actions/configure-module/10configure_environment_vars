import json
import sys
import agent
from bookstack_app_key import find_app_key, store_app_key

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

host = data.get("host", "")

# Keep the key the instance runs with; see pypkg/bookstack_app_key.py
APP_KEY = find_app_key()
store_app_key(APP_KEY)

APP_URL = "https://" + host
agent.write_envfile("app.env", {"APP_URL": APP_URL, "APP_KEY": APP_KEY})

