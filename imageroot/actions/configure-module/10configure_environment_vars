import json
import os
import sys
import agent
import base64
import subprocess

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

host = data.get("host", "")


def generate_laravel_app_key():
    key = os.urandom(32)  # 32 bytes for AES-256
    return "base64:" + base64.b64encode(key).decode("utf-8")


def is_valid_laravel_app_key(value):
    """AES-256-CBC needs exactly 32 bytes: "base64:<32 bytes>" or a 32-character string."""
    if value.startswith("base64:"):
        try:
            return len(base64.b64decode(value[7:], validate=True)) == 32
        except ValueError:
            return False
    return len(value) == 32


def app_key_from_volume():
    """A valid key an administrator put into /config/www/.env by hand, if any."""
    try:
        mountpoint = subprocess.run(
            ["podman", "volume", "inspect", "bookstack-app", "--format", "{{.Mountpoint}}"],
            capture_output=True, text=True, check=True).stdout.strip()
        with open(os.path.join(mountpoint, "www", ".env")) as envfile:
            for line in envfile:
                if line.startswith("APP_KEY="):
                    value = line.split("=", 1)[1].strip().strip('"')
                    return value if is_valid_laravel_app_key(value) else ""
    except (OSError, subprocess.CalledProcessError):
        pass
    return ""


dt = agent.read_envfile("app-db.env") if os.path.exists("app-db.env") else {}
APP_KEY = dt.get("APP_KEY", "")
if not is_valid_laravel_app_key(APP_KEY):
    # Release 1.2.0 stored a 64-character random string, which Laravel refuses
    # ("Unsupported cipher or incorrect key length"), so BookStack never ran with
    # it and nothing was encrypted with it: replacing it loses no data.
    APP_KEY = app_key_from_volume() or generate_laravel_app_key()
    if dt:
        dt["APP_KEY"] = APP_KEY
        agent.write_envfile("app-db.env", dt)

APP_URL = "https://" + host
agent.write_envfile("app.env", {"APP_URL": APP_URL, "APP_KEY": APP_KEY})

